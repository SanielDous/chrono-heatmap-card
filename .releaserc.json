{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "RELEASE_VERSION=${nextRelease.version} pnpm build"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "dist/chrono-heatmap-card.js", "label": "chrono-heatmap-card.js" }]
      }
    ]
  ]
}
