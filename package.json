{
  "name": "chrono-heatmap-card",
  "version": "0.0.0-development",
  "private": true,
  "description": "Home Assistant card that shows an entity's history as a configurable time-grid heatmap",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/SanielDous/ha-heatmap-card.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "screenshots": "playwright test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "date-fns": "^4.1.0",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "happy-dom": "^19.0.2",
    "prettier": "^3.6.2",
    "@semantic-release/exec": "^7.1.0",
    "semantic-release": "^24.2.9",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "yaml": "^2.8.1",
    "vitest": "^3.2.4"
  }
